# MongoDB Connection String (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Admin Dashboard Password (Required)
ADMIN_PASSWORD=your_secure_admin_password_here

# Admin HMAC Session Secret (Required for production)
ADMIN_SESSION_SECRET=a_random_64_character_hex_or_alphanumeric_string_for_signing_sessions

# Public Site URL for SEO and OpenGraph metadata (Optional, defaults to https://dawoodrana.com)
NEXT_PUBLIC_SITE_URL=https://dawoodrana.com
